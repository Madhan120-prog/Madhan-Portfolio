---
import ProjectArt from './ProjectArt.astro';
import { projects } from '../data/profile';
---
<section class="section c-amber" id="projects">
  <div class="container">
    <div class="channel"><span>Projects</span><span class="line"></span></div>
    <h2 class="section-title reveal">Things I've built</h2>
    <p class="section-sub reveal">AI assistants, research tools, and apps. Expand any card for the full story.</p>

    <div class="grid">
      {projects.map((p, i) => (
        <article class={`card panel reveal c-${p.accent} ${i === 0 ? 'featured' : ''}`}>
          <div class="cover"><ProjectArt slug={p.slug} /></div>
          <div class="body">
            <div class="meta">
              <span class="kicker mono">{p.emoji} {p.kicker}</span>
              {p.status && <span class="status mono">{p.status}</span>}
            </div>
            <h3>{p.title}</h3>
            <p class="blurb muted">{p.blurb}</p>
            <div class="tags">
              {p.tech.map((t) => <span class="chip">{t}</span>)}
            </div>
            <details class="more">
              <summary class="mono">Show details</summary>
              <ul>{p.details.map((d) => <li>{d}</li>)}</ul>
            </details>
            {(p.repo || p.demo) && (
              <div class="links">
                {p.repo && <a class="btn small" href={p.repo} target="_blank" rel="noopener">GitHub ↗</a>}
                {p.demo && <a class="btn small" href={p.demo} target="_blank" rel="noopener">Live demo ↗</a>}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }
  .card { overflow: hidden; display: flex; flex-direction: column; transition: border-color .2s ease, box-shadow .2s ease; }
  .card:hover { border-color: var(--c); box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07); }
  .card.featured { grid-column: span 2; }

  .cover { aspect-ratio: 2 / 1; border-bottom: 1px solid var(--line); }
  .featured .cover { aspect-ratio: 2.6 / 1; }

  .body { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; }
  .kicker { font-size: 12.5px; color: var(--c); }
  .status {
    font-size: 11.5px; padding: 2px 10px; border-radius: 999px;
    color: var(--c); background: color-mix(in srgb, var(--c) 10%, white); border: 1px solid color-mix(in srgb, var(--c) 30%, white);
  }
  h3 { margin: 0; font-size: 20px; line-height: 1.3; }
  .blurb { font-size: 15px; margin: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .more { border-top: 1px solid var(--line); padding-top: 10px; }
  .more summary {
    cursor: pointer; font-size: 13px; color: var(--c); list-style: none;
    display: flex; align-items: center; gap: 8px;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+'; font-size: 16px; width: 14px; }
  .more[open] summary::before { content: '−'; }
  .more[open] summary { margin-bottom: 4px; }
  .more ul { margin: 6px 0 0; padding-left: 20px; font-size: 15px; }
  .more li { margin-bottom: 6px; }
  .more li::marker { color: var(--c); }

  .links { display: flex; gap: 8px; flex-wrap: wrap; }
  .btn.small { padding: 7px 12px; font-size: 14px; border-radius: 10px; }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .card.featured { grid-column: auto; }
    .featured .cover { aspect-ratio: 2 / 1; }
  }
</style>
