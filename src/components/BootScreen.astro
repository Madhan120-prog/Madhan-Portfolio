---
// A short "monitor boot" intro, shown once per browser session. Click or press any key to skip.
const lines = [
  '> initializing vitals monitor…',
  '> loading patient: madhan.k.tammineni',
  '> leads connected: AI · full-stack · research',
  '> signal stable ✓',
];
---
<div class="boot" hidden aria-hidden="true">
  <div class="boot-inner mono">
    {lines.map((l, i) => <p style={`--d:${i * 0.38}s`}>{l}</p>)}
    <svg viewBox="0 0 300 60" class="boot-ecg"><path pathLength="1" d="M0 30 H110 l8 -20 l10 44 l9 -34 l6 10 H300" /></svg>
    <span class="skip-hint">click or press any key to skip</span>
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.querySelector('.boot');
    if (!el) return;
    var seen = false;
    try { seen = sessionStorage.getItem('booted') === '1'; } catch (e) {}
    if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    var done = function () {
      if (el.classList.contains('out')) return;
      el.classList.add('out');
      document.documentElement.style.overflow = '';
      try { sessionStorage.setItem('booted', '1'); } catch (e) {}
      setTimeout(function () { el.remove(); }, 500);
    };
    setTimeout(done, 2600);
    el.addEventListener('click', done);
    window.addEventListener('keydown', done, { once: true });
  })();
</script>

<style>
  .boot {
    position: fixed; inset: 0; z-index: 200; display: grid; place-items: center;
    background: #05080a; color: #2bf0a0; transition: opacity .45s ease, transform .45s ease;
  }
  .boot[hidden] { display: none; }
  .boot.out { opacity: 0; transform: scale(1.03); pointer-events: none; }
  .boot-inner { width: min(460px, calc(100% - 32px)); font-size: 14px; }
  .boot p { margin: 0 0 6px; opacity: 0; animation: line .3s ease forwards; animation-delay: var(--d); }
  .boot-ecg { width: 100%; margin-top: 18px; }
  .boot-ecg path {
    fill: none; stroke: #2bf0a0; stroke-width: 2.5; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1; filter: drop-shadow(0 0 6px #2bf0a0);
    animation: draw 1.4s .9s ease-out forwards;
  }
  .skip-hint { display: block; margin-top: 18px; font-size: 11px; color: #5c7a73; }
  @keyframes line { to { opacity: 1; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
