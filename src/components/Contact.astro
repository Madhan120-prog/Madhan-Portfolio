---
import Avatar from './Avatar.astro';
import { profile } from '../data/profile';
---
<section class="section c-green" id="contact">
  <div class="container">
    <div class="channel"><span>CH 06 · Contact</span><span class="line"></span></div>
    <div class="card panel reveal">
      <div class="copy">
        <h2 class="section-title">Let's build something 🤝</h2>
        <p class="muted">
          I'm open to full-time AI engineer and software engineer roles starting Dec 2026.
          Have a role, a project, or just want to talk about AI in healthcare? My inbox is open.
        </p>
        <div class="actions">
          <a class="btn primary" href={`mailto:${profile.email}`}>✉️ {profile.email}</a>
          <button class="btn" data-copy-email type="button">📋 Copy email</button>
        </div>
        <ul class="socials">
          <li><a href={profile.links.github} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
            GitHub</a></li>
          <li><a href={profile.links.linkedin} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            LinkedIn</a></li>
        </ul>
      </div>
      <div class="art"><Avatar size={220} /></div>
    </div>
  </div>
</section>

<style>
  .card {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; padding: 40px;
    background:
      radial-gradient(600px circle at 100% 0%, color-mix(in srgb, var(--green) 14%, transparent), transparent 60%),
      var(--panel);
  }
  .copy p { font-size: 18px; max-width: 520px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0; }
  .socials { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; }
  .socials a { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--muted); }
  .socials a:hover { color: var(--green); }
  .art { display: grid; place-items: center; }
  @media (max-width: 800px) {
    .card { grid-template-columns: 1fr; padding: 26px; }
    .art { order: -1; }
    .art :global(svg) { width: 160px; }
  }
</style>
