---
import { skillGroups, extras } from '../data/profile';
const all = skillGroups.flatMap((g) => g.items.map((s) => ({ s, color: g.color })));
---
<section class="section c-pink" id="skills">
  <div class="container">
    <div class="channel"><span>CH 04 · Skills</span><span class="line"></span></div>
    <h2 class="section-title reveal">My toolkit</h2>
    <p class="section-sub reveal">What I reach for, grouped by where it lives in the stack.</p>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[...all, ...all].map(({ s, color }) => <span class={`tick mono c-${color}`}>{s}</span>)}
    </div>
  </div>

  <div class="container">
    <div class="groups">
      {skillGroups.map((g) => (
        <article class={`panel group reveal c-${g.color}`}>
          <header>
            <span class="g-emoji" aria-hidden="true">{g.emoji}</span>
            <h3>{g.name}</h3>
            <span class="count mono">{g.items.length}</span>
          </header>
          <ul>
            {g.items.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <h3 class="extras-title mono reveal">✨ Also worth knowing</h3>
    <div class="extras">
      {extras.map((x) => (
        <article class="panel extra reveal">
          <span class="x-emoji" aria-hidden="true">{x.emoji}</span>
          <div>
            <strong>{x.title}</strong>
            <p class="muted">{x.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ticker {
    overflow: hidden; margin: 0 0 32px; padding: 14px 0;
    border-block: 1px solid var(--line); background: var(--panel);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; gap: 36px; width: max-content; animation: marquee 50s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .tick { font-size: 15px; color: var(--c); white-space: nowrap; }
  .tick::before { content: '◆ '; opacity: .5; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .group { padding: 22px; border-top: 3px solid var(--c); }
  header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .g-emoji { font-size: 24px; }
  h3 { margin: 0; font-size: 18px; }
  .count {
    margin-left: auto; font-size: 12px; color: var(--c);
    border: 1px solid var(--c); border-radius: 999px; padding: 1px 9px;
  }
  ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  li.chip { transition: border-color .15s, transform .15s; }
  li.chip:hover { border-color: var(--c); transform: translateY(-2px); }

  .extras-title { margin: 48px 0 16px; font-size: 15px; color: var(--amber); }
  .extras { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .extra { display: flex; gap: 14px; padding: 18px; }
  .x-emoji { font-size: 26px; }
  .extra p { margin: 4px 0 0; font-size: 15px; }

  @media (max-width: 720px) {
    .groups, .extras { grid-template-columns: 1fr; }
  }
</style>
