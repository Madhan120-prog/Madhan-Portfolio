---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Notes · Madhan Kumar Tammineni" description="Everyday thoughts, weekly learnings, and build logs.">
  <section class="section c-violet">
    <div class="container narrow">
      <div class="channel"><span>Notes</span><span class="line"></span></div>
      <h1 class="section-title">My notebook 📓</h1>
      <p class="section-sub">
        Everyday thoughts, weekly learnings, and build logs.
        <a href={withBase('/rss.xml')}>Subscribe via RSS</a>.
      </p>

      <div class="filters" role="group" aria-label="Filter by tag">
        <button class="chip active" data-tag="">All · {posts.length}</button>
        {tags.map((t) => <button class="chip" data-tag={t}>#{t}</button>)}
      </div>

      <div class="list">
        {posts.map((post) => (
          <div data-tags={post.data.tags.join(' ')}><PostCard post={post} /></div>
        ))}
      </div>
      {posts.length === 0 && <p class="muted">No notes yet. Check back soon!</p>}
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters [data-tag]');
  const items = document.querySelectorAll<HTMLElement>('.list > [data-tags]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const tag = b.dataset.tag;
    buttons.forEach((x) => x.classList.toggle('active', x === b));
    items.forEach((i) => { i.hidden = !!tag && !i.dataset.tags!.split(' ').includes(tag); });
  }));
</script>

<style>
  .narrow { width: min(820px, 100% - 32px); }
  .section-sub a { color: var(--violet); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .filters .chip { cursor: pointer; font-size: 13px; }
  .filters .chip.active { background: var(--violet); border-color: var(--violet); color: var(--bg); }
  .list { display: grid; gap: 14px; }
</style>
