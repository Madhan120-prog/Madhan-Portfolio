---
import '../styles/global.css';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.roles.slice(0, 2).join(' & ')}`,
  description = profile.tagline,
} = Astro.props;

const nav = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/blog', label: 'Notes' },
  { href: '/#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${profile.shortName}'s notes`} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="topbar">
      <div class="container bar">
        <a href={withBase('/')} class="brand" aria-label="Home">
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--green)"/><path d="M4 17h6l2-5 4 10 3-8 2 3h7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>madhan<span class="muted">.dev</span></span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            {nav.map((n) => <li><a href={withBase(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
        <button class="icon-btn menu-btn" data-menu-toggle aria-label="Open menu" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
      <div class="scroll-progress" aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container foot">
        <svg class="foot-ecg" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 H240 l10 -14 l10 28 l8 -22 l6 8 H600" fill="none" stroke="var(--green)" stroke-width="1.5" />
        </svg>
        <p class="mono muted">© {new Date().getFullYear()} {profile.name} · Built with Astro 💚</p>
      </div>
    </footer>

    <script define:vars={{ email: profile.email }}>
      window.__EMAIL__ = email;
    </script>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: -999px; top: 8px; z-index: 100;
    background: var(--green); color: #fff; padding: 8px 14px; border-radius: 8px;
  }
  .skip:focus { left: 8px; }

  .topbar {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; font-size: 18px; }
  nav { margin-left: auto; }
  .nav-links { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav-links a {
    display: block; padding: 8px 12px; border-radius: 10px; text-decoration: none;
    font-size: 15px; font-weight: 500; color: var(--muted); transition: color .15s, background .15s;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--green); background: color-mix(in srgb, var(--green) 8%, white); }
  .icon-btn {
    display: grid; place-items: center; width: 40px; height: 40px;
    border-radius: 10px; border: 1px solid var(--line); background: #fff; color: var(--text); cursor: pointer;
  }
  .menu-btn { display: none; margin-left: auto; }

  .scroll-progress {
    position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    transform-origin: left; transform: scaleX(var(--progress, 0)); background: var(--green);
  }

  @media (max-width: 900px) {
    .menu-btn { display: grid; }
    nav { display: none; }
    :global(.menu-open) nav { display: block; position: absolute; top: 64px; left: 0; right: 0; margin: 0; }
    .nav-links {
      flex-direction: column; padding: 8px 16px 16px; gap: 2px;
      background: #fff; border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
    }
    .nav-links a { padding: 12px; font-size: 17px; }
  }

  .footer { padding: 72px 0 40px; border-top: 1px solid var(--line); margin-top: 72px; background: var(--bg-2); }
  .foot { text-align: center; }
  .foot-ecg { width: 100%; height: 40px; margin-bottom: 12px; opacity: .5; }
  .foot p { margin: 4px 0; font-size: 13px; }
</style>
