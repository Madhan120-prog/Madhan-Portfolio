---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title = `${profile.name} · ${profile.roles.slice(0, 2).join(' & ')}`,
  description = profile.tagline,
  home = false,
} = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const nav = [
  { href: '/#about', label: 'About', ch: '01' },
  { href: '/#experience', label: 'Experience', ch: '02' },
  { href: '/#projects', label: 'Projects', ch: '03' },
  { href: '/#skills', label: 'Skills', ch: '04' },
  { href: '/blog', label: 'Notes', ch: '05' },
  { href: '/#contact', label: 'Contact', ch: '06' },
];

// Command palette entries (⌘K / Ctrl+K)
const commands = [
  ...nav.map((n) => ({ label: `Go to ${n.label}`, hint: `CH ${n.ch}`, href: withBase(n.href), group: 'Navigate' })),
  { label: 'Toggle light / dark', hint: 'T', action: 'theme', group: 'Actions' },
  { label: 'Copy email address', hint: profile.email, action: 'copy-email', group: 'Actions' },
  { label: 'Open GitHub', hint: '↗', href: profile.links.github, group: 'Links' },
  { label: 'Open LinkedIn', hint: '↗', href: profile.links.linkedin, group: 'Links' },
  ...posts.slice(0, 8).map((p) => ({ label: `${p.data.emoji} ${p.data.title}`, hint: 'note', href: withBase(`/blog/${p.id}`), group: 'Notes' })),
];
---
<!doctype html>
<html lang="en" data-theme="dark" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${profile.shortName}'s notes`} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply saved theme before paint. Monitor (dark) is the default look.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <div class="cursor-glow" aria-hidden="true"></div>

    <header class="topbar">
      <div class="container bar">
        <a href={withBase('/')} class="brand" aria-label="Home">
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--green)"/><path d="M4 17h6l2-5 4 10 3-8 2 3h7" fill="none" stroke="var(--bg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>madhan<span class="muted">.dev</span></span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            {nav.map((n) => (
              <li><a href={withBase(n.href)}><span class="mono ch">{n.ch}</span>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="bar-actions">
          <button class="icon-btn kbd-btn" data-open-palette aria-label="Open command palette">
            <span class="mono">⌘K</span>
          </button>
          <button class="icon-btn" data-theme-toggle aria-label="Toggle light or dark theme">
            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <button class="icon-btn menu-btn" data-menu-toggle aria-label="Open menu" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <div class="scroll-progress" aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container foot">
        <svg class="foot-ecg" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 H240 l10 -14 l10 28 l8 -22 l6 8 H600" fill="none" stroke="var(--green)" stroke-width="2" />
        </svg>
        <p class="mono muted">
          © {new Date().getFullYear()} {profile.name} · Built with Astro · Signal stable 💚
        </p>
        <p class="mono muted small">Tip: press <kbd>⌘K</kbd> / <kbd>Ctrl K</kbd> to jump anywhere.</p>
      </div>
    </footer>

    <!-- Command palette -->
    <dialog class="palette" aria-label="Command palette">
      <div class="palette-box">
        <input type="text" placeholder="Type a command or search…" aria-label="Search commands" autocomplete="off" />
        <ul role="listbox">
          {commands.map((c) => (
            <li role="option" data-group={c.group}>
              {c.href ? (
                <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  <span>{c.label}</span><span class="mono muted">{c.hint}</span>
                </a>
              ) : (
                <button type="button" data-action={c.action}>
                  <span>{c.label}</span><span class="mono muted">{c.hint}</span>
                </button>
              )}
            </li>
          ))}
        </ul>
        <p class="palette-foot mono muted">↑↓ to move · Enter to open · Esc to close</p>
      </div>
    </dialog>

    <div class="toast mono" role="status" aria-live="polite"></div>

    <script define:vars={{ email: profile.email }}>
      window.__EMAIL__ = email;
    </script>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: -999px; top: 8px; z-index: 100;
    background: var(--green); color: var(--bg); padding: 8px 14px; border-radius: 8px;
  }
  .skip:focus { left: 8px; }

  .cursor-glow {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background: radial-gradient(520px circle at var(--mx, -999px) var(--my, -999px), var(--glow), transparent 60%);
  }
  main, .footer { position: relative; z-index: 1; }

  .topbar {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; font-size: 18px; }
  nav { margin-left: auto; }
  .nav-links { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav-links a {
    display: flex; align-items: baseline; gap: 6px;
    padding: 8px 12px; border-radius: 10px; text-decoration: none; font-size: 15px; color: var(--muted);
    transition: color .15s, background .15s;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--text); background: var(--panel-2); }
  .nav-links a.active .ch { color: var(--green); }
  .ch { font-size: 11px; opacity: .7; }
  .bar-actions { display: flex; gap: 8px; }
  .icon-btn {
    display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 10px;
    border-radius: 10px; border: 1px solid var(--line); background: var(--panel); color: var(--text); cursor: pointer;
  }
  .icon-btn:hover { border-color: var(--green); }
  .kbd-btn span { font-size: 12px; }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: none; }
  .menu-btn { display: none; }

  .scroll-progress {
    position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    transform-origin: left; transform: scaleX(var(--progress, 0));
    background: linear-gradient(90deg, var(--green), var(--cyan), var(--pink));
  }

  @media (max-width: 900px) {
    .menu-btn { display: grid; }
    .kbd-btn { display: none; }
    nav { position: absolute; top: 64px; left: 0; right: 0; margin: 0; display: none; }
    :global(.menu-open) nav { display: block; }
    .nav-links {
      flex-direction: column; padding: 12px 16px 18px; gap: 2px;
      background: var(--bg); border-bottom: 1px solid var(--line);
    }
    .nav-links a { padding: 12px; font-size: 17px; }
    .bar-actions { margin-left: auto; }
  }

  .footer { padding: 80px 0 40px; }
  .foot { text-align: center; }
  .foot-ecg { width: 100%; height: 40px; margin-bottom: 16px; opacity: .6; }
  .foot p { margin: 4px 0; font-size: 13px; }
  .small { font-size: 12px !important; }
  kbd {
    font-family: var(--mono); font-size: 11px; padding: 1px 6px; border-radius: 5px;
    border: 1px solid var(--line); background: var(--panel);
  }

  .palette {
    width: min(600px, calc(100% - 32px)); padding: 0; border: none; background: transparent;
    margin-top: 12vh; color: var(--text);
  }
  .palette::backdrop { background: rgba(0, 0, 0, .55); backdrop-filter: blur(4px); }
  .palette-box {
    background: var(--panel); border: 1px solid var(--line); border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .45); overflow: hidden;
  }
  .palette input {
    width: 100%; padding: 18px 20px; font: 500 17px var(--font); color: var(--text);
    background: transparent; border: none; border-bottom: 1px solid var(--line); outline: none;
  }
  .palette ul { list-style: none; margin: 0; padding: 8px; max-height: 50vh; overflow: auto; }
  .palette li a, .palette li button {
    display: flex; justify-content: space-between; gap: 16px; width: 100%;
    padding: 11px 12px; border-radius: 10px; text-decoration: none; color: var(--text);
    background: none; border: none; font: 15px var(--font); text-align: left; cursor: pointer;
  }
  .palette li span:last-child { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .palette li.sel a, .palette li.sel button { background: var(--panel-2); outline: 1px solid var(--green); }
  .palette li[hidden] { display: none; }
  .palette-foot { margin: 0; padding: 10px 16px; font-size: 12px; border-top: 1px solid var(--line); }

  .toast {
    position: fixed; bottom: 24px; left: 50%; z-index: 80;
    transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
    padding: 10px 16px; border-radius: 10px; font-size: 13px;
    background: var(--green); color: var(--bg); transition: all .25s ease;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
</style>
